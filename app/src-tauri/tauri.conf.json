{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SalemStudy",
  "version": "0.2.3",
  "identifier": "net.serverside.webassign-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SalemStudy",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#161618",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 30.25 },
        "acceptFirstMouse": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxRDY1OEQ5QTVCQzgzQjMKUldTemc3eWwyVmpXc2JDTGdGOHl1QndBZGMyNU9USUJ6ZWVPTE9aM241cU13NzhPM0dXMXF2Z1EK",
      "endpoints": ["https://github.com/salem-5/SalemStudy/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
